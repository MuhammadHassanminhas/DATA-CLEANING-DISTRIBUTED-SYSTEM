# Copy to .env and fill in before running anything.
# .env is gitignored — never commit it (CLAUDE.md §12).
#
# Every value below is a PLACEHOLDER. Replace them all; nothing here is a
# working credential. Generate the secrets with something like:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Which keys you need depends on how far you are running the stack:
#   local Docker Compose (M1)      -> sections 1-2
#   AKS deploy + secrets (M1.5)    -> sections 1-3
#   observability stack (1.5.6)    -> sections 1-4

# --- 1. Core service config (docker compose + AKS) --------------------

LOG_LEVEL=INFO

POSTGRES_USER=coordinator
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=coordinator

COORDINATOR_PORT=8443
DASHBOARD_PORT=8444

# --- 2. Worker enrollment (Phase 1.3) ---------------------------------
# ENROLLMENT_SECRET is the shared bootstrap credential every worker
# presents at registration (Decision #9). CREDENTIAL_PEPPER is the
# server-side pepper for HMAC-SHA256 credential hashing (Decision #10).

ENROLLMENT_SECRET=replace-me-enrollment-secret
CREDENTIAL_PEPPER=replace-me-credential-pepper

# --- 3. Terraform + AKS (Step 1.5.1 onward) ---------------------------
# TF_API_TOKEN is your HCP Terraform (app.terraform.io) user API token.
# Scripts export it as TF_TOKEN_app_terraform_io; do not set that yourself.
# The HCP workspace must run in LOCAL execution mode so the azurerm
# provider can use your local `az login` credentials.
#
# ARM_SUBSCRIPTION_ID is optional here — every script falls back to
# `az account show --query id -o tsv` when it is absent.

TF_API_TOKEN=replace-me-hcp-terraform-token
TF_CLOUD_ORGANIZATION=replace-me-terraform-cloud-org
# ARM_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Dashboard edge basic-auth, applied at the ingress (Step 1.5.5).
# Consumed by infra/helm/bootstrap-secrets.ps1.
DASHBOARD_USER=replace-me
DASHBOARD_PASSWORD=replace-me

# --- 4. Observability (Step 1.5.6) ------------------------------------
# All three are read by infra/helm/bootstrap-secrets.ps1 and
# infra/apply-observability.ps1, which THROW if any is missing.
# ALERTMANAGER_WEBHOOK_URL is the Discord/Slack incoming webhook that
# receives alerts — for a Discord webhook, append /slack to the URL.

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me
ALERTMANAGER_WEBHOOK_URL=replace-me-webhook-url
