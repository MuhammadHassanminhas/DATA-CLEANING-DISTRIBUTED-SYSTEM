# Copy to .env and adjust before running `docker compose up`.
# .env is gitignored — never commit it.

LOG_LEVEL=INFO

POSTGRES_USER=coordinator
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=coordinator

COORDINATOR_PORT=8443
DASHBOARD_PORT=8444

# Phase 1.3 — worker registration
ENROLLMENT_SECRET=change-me-dev-enrollment-secret
CREDENTIAL_PEPPER=change-me-dev-credential-pepper
