.venv
.venv-*/
.env
__pycache__/
*.pyc
certs/

# Terraform — never commit provider cache, local state, or plans.
# .terraform.lock.hcl IS committed (provider version pins, no secrets).
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan

# Local tooling caches. Not project code — these have shown up as untracked
# noise in every session's `git status` since Phase 1.5.0.
.claude.backup/
.playwright-mcp/
.pytest_cache/
.ruff_cache/

